# Sistema operativo e IDE
.DS_Store
.idea/
*.iml
.vscode/

# Java
*.class
java/out/
java/build/

# Scala
.scala-build/
.bsp/
.metals/
.bloop/

# Clojure (Leiningen)
target/
.lein-*
.nrepl-port
.cpcache/
.clj-kondo/.cache/

# Python (herramientas del experimento)
__pycache__/
.venv/

# Temporales del experimento (los resultados en resultados/ sí se versionan)
experimento/tmp/

# Salidas de simular.sh (se regeneran en cada ejecución)
salida/

# Escenarios grandes: se regeneran con datos/generador.py y se verifican con datos/escenarios/huellas.sha256
datos/escenarios/V3/
datos/escenarios/V4/
datos/escenarios/C1/
datos/escenarios/X1/

# Ejecutables construidos (se generan con <lenguaje>/construir.sh)
*.jar
java/clases/

# Resultados que no son evidencia: la prueba del orquestador y los registros de construcción
resultados/prueba/
resultados/construccion_*.log

# Archivo intermedio del informe (se genera con informe/generar_informe.py)
informe/informe.json
