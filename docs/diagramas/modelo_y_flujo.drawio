<mxfile host="app.diagrams.net"><diagram id="modelo" name="Modelo y flujo"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Simulador aeroportuario · Modelo y flujo (igual en Java, Scala y Clojure)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;whiteSpace=wrap;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="960" height="30" as="geometry"/></mxCell><mxCell id="st" value="Los datos no cambian: cada etapa es una función que recibe datos y devuelve datos nuevos." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;fontFamily=Inter;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="42" width="960" height="22" as="geometry"/></mxCell><mxCell id="fp" value="&lt;b&gt;pistas.csv&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=13;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="120" height="44" as="geometry"/></mxCell><mxCell id="fv" value="&lt;b&gt;vuelos.csv&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=13;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="120" height="44" as="geometry"/></mxCell><mxCell id="lec" value="&lt;b&gt;Lectura&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;líneas → campos&lt;br&gt;map · filter · split&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;spacing=6;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="180" y="102" width="130" height="80" as="geometry"/></mxCell><mxCell id="val" value="&lt;b&gt;Validación&lt;/b&gt; (RF03)&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;reduce con los códigos válidos&lt;br&gt;Resultado / Either / {:error}&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;spacing=6;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="345" y="102" width="165" height="80" as="geometry"/></mxCell><mxCell id="err" value="&lt;b&gt;errores.csv&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=13;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="357" y="230" width="140" height="44" as="geometry"/></mxCell><mxCell id="comp" value="&lt;b&gt;Compatibilidad&lt;/b&gt;&lt;br&gt;(RN03 y RN09)&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;filter: asignables / no asignables&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;spacing=6;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="575" y="102" width="175" height="80" as="geometry"/></mxCell><mxCell id="torre" value="&lt;b&gt;TorreControl&lt;/b&gt; (RF04 a RF06)&lt;br&gt;&lt;br&gt;1. &lt;b&gt;groupBy&lt;/b&gt; en 12 filas&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(operación × categoría × prioridad)&lt;br&gt;2. &lt;b&gt;sortBy&lt;/b&gt; (hora, código)&lt;br&gt;3. &lt;b&gt;iterate&lt;/b&gt;(paso) → &lt;b&gt;takeWhile&lt;/b&gt; → &lt;b&gt;flatMap&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Estado inmutable: minuto, cabezas de las 12 filas, minuto libre de cada pista&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=13;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="185" height="230" as="geometry"/></mxCell><mxCell id="rep" value="&lt;b&gt;Reportes&lt;/b&gt; (RF07 a RF14)&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;groupBy · map · reduce · sortBy · take&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;spacing=6;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="575" y="230" width="175" height="70" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;operaciones.csv&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=13;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="680" y="350" width="150" height="44" as="geometry"/></mxCell><mxCell id="rpt" value="&lt;b&gt;reporte.txt&lt;/b&gt; + pantalla" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=13;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="500" y="350" width="165" height="44" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Inter;fontColor=#334155;" edge="1" parent="1" source="fp" target="lec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Inter;fontColor=#334155;" edge="1" parent="1" source="fv" target="lec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Inter;fontColor=#334155;" edge="1" parent="1" source="lec" target="val"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="inválidos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Inter;fontColor=#334155;" edge="1" parent="1" source="val" target="err"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="válidos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Inter;fontColor=#334155;" edge="1" parent="1" source="val" target="comp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="asignables" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Inter;fontColor=#334155;" edge="1" parent="1" source="comp" target="torre"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="no asignables" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=block;endFill=1;fontFamily=Inter;fontColor=#334155;" edge="1" parent="1" source="comp" target="rep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="asignadas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Inter;fontColor=#334155;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="torre" target="rep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Inter;fontColor=#334155;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rep" target="ops"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Inter;fontColor=#334155;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="